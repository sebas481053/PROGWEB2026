    nombre: "Laptop Gamer",
    categoria: "Tecnología",
    precio: 25000,
    stock: 8,
    proveedor: {
      nombre: "TechStore",
    },
  },
  {
    id: 2,
    nombre: "Mouse RGB",
    categoria: "Tecnología",
    precio: 800,
    stock: 25,
    proveedor: {
      nombre: "GamingMX",
    },
  },
  {
    id: 3,
    nombre: "Teclado Mecánico",
    categoria: "Tecnología",
    precio: 1500,
    stock: 12,
    proveedor: null,
  },
  {
    id: 4,
    nombre: "Monitor 27 pulgadas",
    categoria: "Tecnología",
    precio: 5200,
