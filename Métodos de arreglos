    proveedor: {
      nombre: "SoundTech",
    },
  },
];

/* Desestructuración */
const [primerProducto] = datos;
const { nombre, precio } = primerProducto;

console.log("Primer producto:");
console.log(nombre, precio);

/* Lista filtrada */
const filtrados = datos.filter((producto) => producto.precio > 1000);

/* Total de precios */
const total = datos.reduce(
  (acumulador, producto) => acumulador + producto.precio,
  0,
);

/* Promedio de precios */
const promedio = total / datos.length;

/* Lista ordenada por precio */
const ordenados = [...datos].sort((a, b) => a.precio - b.precio);

/* Optional Chaining y Nullish Coalescing */
const proveedores = datos.map((producto) => ({
  producto: producto.nombre,
  proveedor: producto.proveedor?.nombre ?? "Sin proveedor registrado",
}));

/* Verificar que no se mutó el arreglo original */
console.log("Arreglo original:");
console.log(datos);

console.log("Resultados:");
console.log({
  filtrados,
  total,
  promedio,
  ordenados,
  proveedores,
});
